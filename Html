<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lumiera Jewelry | Timeless Elegance & Fine Diamond Collection</title>
    
    <!-- Google Fonts & FontAwesome -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* ==========================================
           COLOR PALETTE & SYSTEM VARIABLES
           ========================================== */
        :root {
            --navy-blue: #0F1B29;
            --sapphire: #1B3B6F;
            --warm-taupe: #A39281;
            --champagne: #E8D8C8;
            --champagne-light: #F6F0E8;
            --ivory: #FAF8F5;
            --text-dark: #1F242B;
            --text-muted: #626A75;
            --font-heading: 'Cormorant Garamond', serif;
            --font-body: 'Montserrat', sans-serif;
            --transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* ==========================================
           RESET & BASE STYLES
           ========================================== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: var(--font-body);
            background-color: var(--ivory);
            color: var(--text-dark);
            line-height: 1.7;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, .brand-font {
            font-family: var(--font-heading);
            font-weight: 600;
            letter-spacing: 1.2px;
        }

        a {
            text-decoration: none;
            color: inherit;
            transition: var(--transition);
        }

        ul {
            list-style: none;
        }

        img {
            max-width: 100%;
            height: auto;
            display: block;
        }

        .container {
            max-width: 1240px;
            margin: 0 auto;
            padding: 0 24px;
        }

        .section-padding {
            padding: 110px 0;
        }

        .text-center { 
            text-align: center; 
        }

        .section-title {
            font-size: 3rem;
            color: var(--navy-blue);
            margin-bottom: 12px;
            line-height: 1.15;
        }

        .section-subtitle {
            font-size: 0.85rem;
            color: var(--warm-taupe);
            text-transform: uppercase;
            letter-spacing: 3px;
            margin-bottom: 12px;
            display: block;
            font-weight: 600;
        }

        /* ==========================================
           BUTTONS & UTILITIES
           ========================================== */
        .btn {
            display: inline-block;
            padding: 15px 36px;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 2px;
            border: 1px solid transparent;
            cursor: pointer;
            transition: var(--transition);
            border-radius: 2px;
        }

        .btn-primary {
            background-color: var(--sapphire);
            color: var(--ivory);
            border-color: var(--sapphire);
        }

        .btn-primary:hover {
            background-color: var(--navy-blue);
            border-color: var(--navy-blue);
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(15, 27, 41, 0.15);
        }

        .btn-outline {
            background-color: transparent;
            color: var(--navy-blue);
            border-color: var(--warm-taupe);
        }

        .btn-outline:hover {
            background-color: var(--warm-taupe);
            color: var(--ivory);
        }

        /* ==========================================
           HEADER & NAVIGATION
           ========================================== */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            background-color: rgba(250, 248, 245, 0.94);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(232, 216, 200, 0.6);
        }

        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 90px;
        }

        .logo {
            font-family: var(--font-heading);
            font-size: 2.2rem;
            font-weight: 700;
            color: var(--navy-blue);
            letter-spacing: 3px;
            text-transform: uppercase;
        }

        .logo span {
            color: var(--warm-taupe);
            font-weight: 400;
        }

        .nav-links {
            display: flex;
            gap: 40px;
        }

        .nav-links a {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--navy-blue);
            font-weight: 500;
            position: relative;
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -6px;
            left: 0;
            width: 0%;
            height: 1px;
            background-color: var(--warm-taupe);
            transition: var(--transition);
        }

        .nav-links a:hover::after {
            width: 100%;
        }

        .nav-icons {
            display: flex;
            gap: 22px;
            color: var(--navy-blue);
            font-size: 1.1rem;
        }

        .nav-icons a:hover {
            color: var(--warm-taupe);
        }

        /* ==========================================
           HERO SECTION
           ========================================== */
        .hero {
            height: 100vh;
            min-height: 650px;
            background: linear-gradient(135deg, rgba(15, 27, 41, 0.88), rgba(27, 59, 111, 0.7)), 
                        url('https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?q=80&w=1920') center/cover no-repeat;
            display: flex;
            align-items: center;
            color: var(--ivory);
            padding-top: 90px;
        }

        .hero-content {
            max-width: 680px;
        }

        .hero-subtitle {
            color: var(--champagne);
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 4px;
            margin-bottom: 18px;
            display: block;
        }

        .hero-title {
            font-size: 4.2rem;
            line-height: 1.08;
            margin-bottom: 24px;
            font-weight: 400;
        }

        .hero-description {
            font-size: 1.05rem;
            color: rgba(250, 248, 245, 0.88);
            margin-bottom: 40px;
            font-weight: 300;
        }

        /* ==========================================
           BRAND PROFILE & ABOUT
           ========================================== */
        .about-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 70px;
            align-items: center;
        }

        .about-img-box {
            position: relative;
        }

        .about-img-box img {
            border-radius: 2px;
            box-shadow: 0 20px 40px rgba(15, 27, 41, 0.08);
        }

        .about-img-box::before {
            content: '';
            position: absolute;
            top: -18px;
            left: -18px;
            width: 100%;
            height: 100%;
            border: 1px solid var(--champagne);
            z-index: -1;
        }

        .about-text h3 {
            font-size: 2.4rem;
            color: var(--navy-blue);
            margin-bottom: 20px;
            line-height: 1.2;
        }

        .about-text p {
            color: var(--text-muted);
            margin-bottom: 20px;
            font-size: 0.95rem;
        }

        .vision-mission-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
            margin-top: 35px;
            padding-top: 30px;
            border-top: 1px solid var(--champagne);
        }

        .vm-card h4 {
            font-size: 1.3rem;
            color: var(--sapphire);
            margin-bottom: 8px;
        }

        .vm-card p {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 0;
        }

        /* ==========================================
           FEATURED PRODUCTS (KALUNG & GELANG)
           ========================================== */
        .products-section {
            background-color: var(--champagne-light);
        }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
            gap: 30px;
            margin-top: 55px;
        }

        .product-card {
            background: var(--ivory);
            border-radius: 2px;
            overflow: hidden;
            transition: var(--transition);
            border: 1px solid rgba(232, 216, 200, 0.7);
            display: flex;
            flex-direction: column;
        }

        .product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 18px 36px rgba(15, 27, 41, 0.08);
        }

        .product-image {
            position: relative;
            height: 330px;
            overflow: hidden;
            background-color: #ECE5DC;
        }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: var(--transition);
        }

        .product-card:hover .product-image img {
            transform: scale(1.06);
        }

        .product-tag {
            position: absolute;
            top: 15px;
            left: 15px;
            background-color: var(--navy-blue);
            color: var(--champagne);
            padding: 5px 14px;
            font-size: 0.68rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            font-weight: 500;
        }

        .product-details {
            padding: 28px 24px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

        .product-title {
            font-size: 1.55rem;
            color: var(--navy-blue);
            margin-bottom: 10px;
        }

        .product-desc {
            font-size: 0.88rem;
            color: var(--text-muted);
            margin-bottom: 18px;
            flex-grow: 1;
        }

        .product-specs {
            font-size: 0.75rem;
            color: var(--warm-taupe);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 22px;
            padding-top: 14px;
            border-top: 1px dashed var(--champagne);
            font-weight: 500;
        }

        /* ==========================================
           PURCHASE GUIDE
           ========================================== */
        .guide-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 28px;
            margin-top: 55px;
        }

        .guide-step {
            background-color: var(--ivory);
            padding: 40px 28px;
            border: 1px solid var(--champagne);
            border-radius: 2px;
            text-align: center;
            transition: var(--transition);
        }

        .guide-step:hover {
            border-color: var(--warm-taupe);
            transform: translateY(-4px);
        }

        .step-number {
            font-family: var(--font-heading);
            font-size: 3.2rem;
            color: var(--champagne);
            line-height: 1;
            margin-bottom: 16px;
        }

        .guide-step h4 {
            font-size: 1.3rem;
            color: var(--navy-blue);
            margin-bottom: 12px;
        }

        .guide-step p {
            font-size: 0.88rem;
            color: var(--text-muted);
        }

        /* ==========================================
           LOCATION & CONTACT SECTION
           ========================================== */
        .location-section {
            background-color: var(--navy-blue);
            color: var(--ivory);
        }

        .location-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: center;
        }

        .location-info h3 {
            font-size: 2.6rem;
            color: var(--champagne);
            margin-bottom: 20px;
        }

        .address-card {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(232, 216, 200, 0.25);
            padding: 28px;
            border-radius: 2px;
            margin-bottom: 30px;
        }

        .address-card p {
            font-size: 0.92rem;
            color: rgba(250, 248, 245, 0.88);
            line-height: 1.8;
        }

        .address-card i {
            color: var(--champagne);
            margin-right: 10px;
        }

        .store-hours {
            margin-bottom: 35px;
            font-size: 0.9rem;
            color: var(--champagne-light);
        }

        .map-box {
            border-radius: 2px;
            overflow: hidden;
            height: 400px;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.35);
            border: 1px solid rgba(232, 216, 200, 0.2);
        }

        /* ==========================================
           FOOTER
           ========================================== */
        footer {
            background-color: #080E16;
            color: var(--ivory);
            padding: 70px 0 30px;
            border-top: 1px solid rgba(232, 216, 200, 0.12);
            font-size: 0.88rem;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr;
            gap: 45px;
            margin-bottom: 50px;
        }

        .footer-about p {
            color: rgba(250, 248, 245, 0.6);
            margin-top: 16px;
            max-width: 320px;
            font-size: 0.85rem;
        }

        .footer-title {
            font-family: var(--font-heading);
            font-size: 1.25rem;
            color: var(--champagne);
            margin-bottom: 22px;
            letter-spacing: 1px;
        }

        .footer-links li {
            margin-bottom: 12px;
        }

        .footer-links a {
            color: rgba(250, 248, 245, 0.7);
        }

        .footer-links a:hover {
            color: var(--champagne);
        }

        .copyright {
            text-align: center;
            padding-top: 30px;
            border-top: 1px solid rgba(255, 255, 255, 0.06);
            color: rgba(250, 248, 245, 0.4);
            font-size: 0.8rem;
        }

        /* ==========================================
           RESPONSIVE DESIGN
           ========================================== */
        @media (max-width: 992px) {
            .about-grid, .location-grid {
                grid-template-columns: 1fr;
                gap: 40px;
            }
            .hero-title {
                font-size: 3.2rem;
            }
            .footer-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        @media (max-width: 768px) {
            .nav-links {
                display: none;
            }
            .section-title {
                font-size: 2.3rem;
            }
            .footer-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <!-- NAVBAR -->
    <header>
        <div class="container navbar">
            <a href="#" class="logo">Lumiera <span>Jewelry</span></a>
