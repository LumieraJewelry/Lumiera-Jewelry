        /* ==========================================
           COLOR PALETTE & VARIABLES
           ========================================== */
        :root {
            --navy-blue: #0F1B29;
            --sapphire: #1B3B6F;
            --warm-taupe: #A39281;
            --champagne: #E8D8C8;
            --champagne-light: #F4ECE1;
            --ivory: #FAF8F5;
            --text-dark: #1A1A1A;
